GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
# Optional: model id from your Groq plan (e.g. llama-3.3-70b-versatile,
# openai/gpt-oss-120b). Omit to use the built-in default.
RESEARCH_AGENT_MODEL=llama-3.3-70b-versatile
# Optional: set to 1 to enable the all-MiniLM-L6-v2 embedding path for
# near-dup detection and ranking (pull in torch/sklearn/pandas/pyarrow).
# RESEARCH_AGENT_EMBEDDINGS=1
